# Copy this file to .env and fill values locally. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

MYSQL_DATABASE=vehicle_service_db
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-mysql-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional Meta WhatsApp Cloud API configuration
WHATSAPP_ENABLED=False
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BOOKING_ACCEPTED_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
SITE_BASE_URL=http://127.0.0.1:8000
# Required only when running vehicle_service/seed_data.py
SEED_DEMO_PASSWORD=replace-with-a-strong-demo-password
